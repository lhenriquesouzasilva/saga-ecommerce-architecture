
@startuml
title Saga - Fluxo de Falha e Compensacao

autonumber

actor Cliente
participant "Order Service" as Order
participant "Saga Orchestrator" as Saga
queue "Message Broker" as Broker
participant "Inventory Service" as Inventory
participant "Payment Service" as Payment
participant "Gateway Financeiro" as Gateway

== Criacao do pedido ==

Cliente -> Order: POST /orders
activate Order
Order -> Order: Criar pedido PENDING
Order --> Cliente: 202 Accepted + orderId
Order -> Saga: Iniciar Saga
deactivate Order

activate Saga
Saga -> Saga: Persistir estado STARTED

== Reserva de estoque ==

Saga -> Broker: ReserveStock(orderId)
Broker -> Inventory: ReserveStock(orderId)
activate Inventory

Inventory -> Inventory: Validar disponibilidade
Inventory -> Inventory: Reservar produtos
Inventory --> Broker: StockReserved
deactivate Inventory

Broker --> Saga: StockReserved
Saga -> Saga: Atualizar estado STOCK_RESERVED

== Pagamento recusado ==

Saga -> Broker: ProcessPayment(orderId)
Broker -> Payment: ProcessPayment(orderId)
activate Payment

Payment -> Gateway: Solicitar pagamento
activate Gateway
Gateway --> Payment: Pagamento recusado
deactivate Gateway

Payment -> Payment: Registrar recusa
Payment --> Broker: PaymentRejected
deactivate Payment

Broker --> Saga: PaymentRejected

== Inicio da compensacao ==

Saga -> Saga: Atualizar estado COMPENSATING

== Liberacao do estoque ==

Saga -> Broker: ReleaseStock(orderId)
Broker -> Inventory: ReleaseStock(orderId)
activate Inventory

Inventory -> Inventory: Liberar reserva
Inventory --> Broker: StockReleased
deactivate Inventory

Broker --> Saga: StockReleased

== Cancelamento do pedido ==

Saga -> Broker: CancelOrder(orderId)
Broker -> Order: CancelOrder(orderId)
activate Order

Order -> Order: Atualizar status CANCELLED
Order --> Broker: OrderCancelled
deactivate Order

Broker --> Saga: OrderCancelled

== Finalizacao ==

Saga -> Saga: Marcar Saga COMPENSATED
deactivate Saga

Cliente -> Order: GET /orders/{orderId}
Order --> Cliente: Pedido CANCELLED

@enduml
